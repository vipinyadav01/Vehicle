<div class="row mb-4">
    <div class="col-md-8">
        <h1><%= vehicle.name %></h1>
    </div>
    <div class="col-md-4 text-end">
        <a href="/vehicles/edit/<%= vehicle._id %>" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
        <form action="/vehicles/<%= vehicle._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this vehicle?')">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <img src="<%= vehicle.image %>" alt="<%= vehicle.name %>" class="img-fluid rounded">
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Vehicle Details</h5>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item"><strong>Brand:</strong> <%= vehicle.brand %></li>
                    <li class="list-group-item"><strong>Price:</strong> $<%= vehicle.price.toLocaleString() %></li>
                    <li class="list-group-item"><strong>Added on:</strong> <%= vehicle.createdAt.toLocaleDateString() %></li>
                </ul>
                <h5>Description:</h5>
                <p class="card-text"><%= vehicle.description %></p>
                <a href="/vehicles" class="btn btn-primary"><i class="fas fa-arrow-left"></i> Back to All Vehicles</a>
            </div>
        </div>
    </div>
</div>
